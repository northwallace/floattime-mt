  "findings": [
    "Two held maps now have agency-supported access areas: Lake Wenatchee–Plain and Headworks–Kanaskat.",
    "Both dotted courses use explicit main-river endpoint features instead of nearer drainage lines. Wenatchee’s four source forks and all 17 overlapping course panels reviewed.",
    "Lake Wenatchee’s existing agency coordinate is inland of the waterline; it retains its numeric position and stable ID but now displays Area precision.",
    "Headworks gate, permitted-use and upper Kanaskat take-out conditions are visible.",
    "Plain–Highway 2 remains held pending a separate bridge take-out review."
  ],
  "limitations": [
    "All new locations are approximate access areas, not field-verified landing pins.",
    "No planning mileage, gauge, speed calibration, GPS timing or landing connector changed.",
    "Nothing pushed, deployed or published."
  ]
}
